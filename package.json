{
  "name": "viber-workbench",
  "displayName": "Viber Workbench",
  "description": "Workbench for VS Code / Cursor: run workspace scripts with built-in terminal logs, run history, and pluggable remote sync. Cursor users: install from Extensions (search \"Viber Workbench\") or Marketplace item nojsja.viber-workbench.",
  "version": "0.4.0",
  "publisher": "nojsja",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/nojsja/viber-workbench.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "viberWorkbench",
          "title": "Viber Workbench",
          "icon": "media/terminal.svg"
        }
      ]
    },
    "views": {
      "viberWorkbench": [
        {
          "type": "webview",
          "id": "viberWorkbench.launcher",
          "name": "Launcher"
        }
      ]
    },
    "commands": [
      {
        "command": "viberWorkbench.openPanel",
        "title": "Viber Workbench: 打开命令面板",
        "icon": "$(rocket)",
        "category": "Viber Workbench"
      },
      {
        "command": "viberWorkbench.refresh",
        "title": "Viber Workbench: 刷新命令面板",
        "icon": "$(refresh)",
        "category": "Viber Workbench"
      },
      {
        "command": "viberWorkbench.syncRemote",
        "title": "Viber Workbench: 同步执行记录",
        "icon": "$(cloud-upload)",
        "category": "Viber Workbench"
      },
      {
        "command": "viberWorkbench.initCommandConfig",
        "title": "Viber Workbench: 初始化命令配置",
        "icon": "$(new-file)",
        "category": "Viber Workbench"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "viberWorkbench.openPanel",
          "when": "view == viberWorkbench.launcher",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Viber Workbench",
      "properties": {
        "viberWorkbench.commandsSource": {
          "type": "string",
          "enum": [
            "command-runner",
            "viberWorkbench"
          ],
          "default": "command-runner",
          "description": "命令来源：读取 workspace 的 command-runner.commands 或工作台内管理的预设命令"
        },
        "viberWorkbench.terminalName": {
          "type": "string",
          "default": "Viber Workbench",
          "description": "执行脚本时使用的终端名称"
        },
        "viberWorkbench.shellPath": {
          "type": "string",
          "default": "",
          "description": "Optional shell executable for embedded command runner (e.g. /bin/zsh). Leave empty to auto-detect from $SHELL."
        },
        "viberWorkbench.operator": {
          "type": "string",
          "default": "",
          "description": "操作人显示名，留空则自动读取 git config user.name / 系统用户名"
        },
        "viberWorkbench.uiLanguage": {
          "type": "string",
          "enum": [
            "en",
            "zh"
          ],
          "default": "en",
          "enumDescriptions": [
            "English UI (default)",
            "中文界面"
          ],
          "description": "Workbench UI language / 工作台界面语言"
        },
        "viberWorkbench.silentNotifications": {
          "type": "boolean",
          "default": false,
          "description": "Suppress VS Code native notification sounds/toasts. Panel inline toasts are always shown. / 静默 VS Code 系统通知（含音效）；面板内提示仍会显示"
        }
      }
    }
  },
  "scripts": {
    "compile": "npm run compile:ext && npm run compile:webview",
    "compile:ext": "tsc -p ./",
    "compile:webview": "npm run build --prefix webview",
    "watch": "tsc -watch -p ./",
    "watch:webview": "npm run dev --prefix webview",
    "package": "npm run compile && vsce package",
    "lint": "tsc -p ./ --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.1",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "node-pty": "^1.1.0"
  }
}
